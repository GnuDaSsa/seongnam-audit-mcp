{
  "name": "seongnam-audit-mcp",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "http": "node server.mjs --http",
    "build": "node build-site.mjs",
    "test": "node harness.mjs",
    "test:ci": "node --test tests/ci-fixture.test.mjs tests/audit-retrieval.test.mjs tests/query-coverage.test.mjs tests/transport.test.mjs tests/evidence-quality.test.mjs tests/benchmark.test.mjs tests/answer-benchmark.test.mjs tests/protocol*.test.mjs",
    "test:live": "node live-check.mjs",
    "test:protocol": "node --test tests/protocol*.test.mjs",
    "test:bundle": "node --test tests/hosted.test.mjs tests/evidence-quality-bundle.mjs",
    "benchmark": "node benchmark.mjs",
    "benchmark:answers": "node answer-benchmark.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "esbuild": "0.28.2"
  }
}
